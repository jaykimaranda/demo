{
  "manifest_version": 3,
  "name": "OnlineJobs.ph Job Watcher",
  "version": "1.0.0",
  "description": "Watches OnlineJobs.ph job search results for new posts matching your keywords (e.g. Webflow) and sends a desktop notification.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://www.onlinejobs.ph/*", "https://onlinejobs.ph/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "OnlineJobs.ph Job Watcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
